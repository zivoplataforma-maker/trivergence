{
  "name": "@trivergence/desktop",
  "version": "0.7.0",
  "description": "Provider-agnostic orchestration desktop for auditable agent workflows",
  "author": "Trivergence contributors",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "pnpm build:main && pnpm build:preload && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "capture:docs": "pnpm --workspace-root build:fresh && node ./scripts/capture-docs-electron.mjs",
    "e2e": "pnpm --workspace-root build:fresh && node ./scripts/e2e-electron.mjs",
    "package:win": "electron-builder --win nsis --x64 --publish never",
    "smoke": "node ./scripts/smoke-electron.mjs",
    "start": "electron .",
    "test": "vitest run --root . src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@trivergence/agents": "workspace:*",
    "@trivergence/contracts": "workspace:*",
    "@trivergence/coordination-contracts": "workspace:*",
    "@trivergence/memory": "workspace:*",
    "@trivergence/orchestration-engine": "workspace:*",
    "@trivergence/persistence": "workspace:*",
    "@trivergence/policy-engine": "workspace:*",
    "@trivergence/provider-adapters": "workspace:*",
    "@trivergence/runtime": "workspace:*",
    "@trivergence/workspace": "workspace:*",
    "@trivergence/workflows": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "axe-core": "4.13.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.11"
  }
}
